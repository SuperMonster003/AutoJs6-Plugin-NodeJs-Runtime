<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />
    <!-- M2.6: raw Node network builtins (http/https/net/dns/tls) are enabled
         by default; sockets need this even for loopback. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Node scripts get a desktop-like fs reach and let Android do the
         confining. The runtime runs under its own uid (a separate
         applicationId from the host), so it cannot inherit the host's grants
         and has to declare storage access itself; mirrors the host manifest.
         MANAGE_EXTERNAL_STORAGE still needs the user to grant "All files
         access" for this plugin in system settings. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:hasCode="true">

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="SuperMonster003" />

        <service
            android:name=".NodeJsPluginInfoService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">

            <meta-data
                android:name="requiresHostVersion"
                android:value="3923" />

            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="nodejs" />
            </intent-filter>
        </service>

        <service
            android:name=".NodeJsRuntimePluginService"
            android:exported="true"
            android:process=":nodejs_runtime"
            android:permission="org.autojs.permission.PLUGIN">

            <meta-data
                android:name="requiresHostVersion"
                android:value="3923" />

            <intent-filter>
                <action android:name="org.autojs.plugin.nodejs.RUNTIME" />
                <category android:name="nodejs" />
            </intent-filter>
        </service>

    </application>

</manifest>
