    <string name="local_network_title">本機網路存取</string>
    <string name="plugin_description">為 AutoJs6 提供 Node.js 24.21.0 原生執行階段</string>
    <string name="runtime_settings_explanation" tools:ignore="TypographyDashes">排隊上限留空表示不限 (預設), 輸入 0 則不接受等待指令碼. 平行槽數為 1-8, 預設 2. 修改後影響後續排程, 已執行和已排隊的指令碼會保留.</string>
    <string name="runtime_settings_invalid_queue">請輸入 0 到 2147483647 之間的整數, 或留空.</string>
