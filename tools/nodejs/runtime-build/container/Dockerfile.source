FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git patch python3 ninja-build make clang-19 lld-19 \
    g++-multilib pkg-config unzip xz-utils ccache

ARG NDK_SHA1=87e2bb7e9be5d6a1c6cdf5ec40dd4e0c6d07c30b
RUN curl -fL --retry 2 -o /tmp/ndk.zip https://dl.google.com/android/repository/android-ndk-r29-linux.zip \
    && echo "$NDK_SHA1  /tmp/ndk.zip" | sha1sum -c - \
    && unzip -q /tmp/ndk.zip -d /opt \
    && rm /tmp/ndk.zip
ENV ANDROID_NDK_HOME=/opt/android-ndk-r29
ENV CC_host=clang-19 CXX_host=clang++-19

# Node 26 builds V8 Temporal from the vendored temporal_rs crates. The Android
# targets serve libnode; i686 serves the 32-bit host mksnapshot of ARMv7 builds.
ARG RUSTUP_VERSION=1.29.2
ARG RUSTUP_INIT_SHA256=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
ARG RUST_VERSION=1.99.1
ENV RUSTUP_HOME=/opt/rust/rustup CARGO_HOME=/opt/rust/cargo PATH=/opt/rust/cargo/bin:$PATH
RUN curl -fL --retry 2 -o /tmp/rustup-init \
      https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/x86_64-unknown-linux-gnu/rustup-init \
    && echo "$RUSTUP_INIT_SHA256  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain $RUST_VERSION \
    && rm /tmp/rustup-init \
    && rustup target add aarch64-linux-android armv7-linux-androideabi x86_64-linux-android i686-unknown-linux-gnu

ENV TZ=UTC LC_ALL=C SOURCE_DATE_EPOCH=1754006400
WORKDIR /work
