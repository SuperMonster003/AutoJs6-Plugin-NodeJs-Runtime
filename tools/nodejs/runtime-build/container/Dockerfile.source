FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git patch python3 ninja-build make clang-18 lld-18 \
    g++-multilib pkg-config unzip xz-utils ccache

ARG NDK_SHA1=a7b54a5de87fecd125a17d54f73c446199e72a64
RUN curl -fL --retry 2 -o /tmp/ndk.zip https://dl.google.com/android/repository/android-ndk-r28c-linux.zip \
    && echo "$NDK_SHA1  /tmp/ndk.zip" | sha1sum -c - \
    && unzip -q /tmp/ndk.zip -d /opt
ENV ANDROID_NDK_HOME=/opt/android-ndk-r28c
ENV CC_host=clang-18 CXX_host=clang++-18
ENV TZ=UTC LC_ALL=C SOURCE_DATE_EPOCH=1754006400
WORKDIR /work
