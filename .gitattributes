*.so filter=lfs diff=lfs merge=lfs -text
app/src/main/jniLibs/arm64-v8a/libnode.so filter=lfs diff=lfs merge=lfs -text
app/src/main/jniLibs/armeabi-v7a/libnode.so filter=lfs diff=lfs merge=lfs -text
app/src/main/jniLibs/x86_64/libnode.so filter=lfs diff=lfs merge=lfs -text

# These files participate in release SHA-256 trust chains. Keep their bytes
# deterministic across Windows and Unix checkouts.
/app/src/main/assets/nodejs/node-capability-catalog.json text eol=lf
/app/src/main/assets/nodejs/node-plugin-runtime-kit.json text eol=lf
/tools/nodejs/runtime-build/runtime-build.lock.json text eol=lf
/tools/nodejs/runtime-build/*.py text eol=lf
/tools/nodejs/runtime-build/container/Dockerfile.source text eol=lf
/tools/nodejs/runtime-build/container/build-source.sh text eol=lf
/app/src/main/cpp/CMakeLists.txt text eol=lf
# Unified diff context uses a single space for an empty source line.
/tools/nodejs/runtime-build/patches/*.patch text eol=lf whitespace=-blank-at-eol
/releases/nodejs-capability-catalog/** text eol=lf
/releases/nodejs-plugin-runtime-kit/** text eol=lf
/.github/**/*.sh text eol=lf
/app/src/main/assets/licenses/** text eol=lf
# Preserve the fixed upstream license's original mixed indentation.
/app/src/main/assets/licenses/nodejs-mobile-LICENSE.txt whitespace=-space-before-tab
# Preserve the official Node header archive and its upstream license text.
/app/src/main/cpp/node-v24.20.0/** text eol=lf
/app/src/main/cpp/node-v24.20.0/LICENSE whitespace=-space-before-tab
/app/src/main/cpp/node-v24.21.0/** text eol=lf
/app/src/main/cpp/node-v24.21.0/LICENSE whitespace=-space-before-tab

# Keep vendored npm sources byte-identical, including upstream line endings and indentation.
/app/src/androidTest/assets/npm_ecosystem_corpus/node_modules/** -text -whitespace
# These two upstream Setext headings contain exactly seven '=' characters.
/app/src/androidTest/assets/npm_ecosystem_corpus/node_modules/commist/README.md conflict-marker-size=8
/app/src/androidTest/assets/npm_ecosystem_corpus/node_modules/help-me/README.md conflict-marker-size=8
